    "repository": {
        "type": "git",
        "url": "https://github.com/Enterwell/react-form-validation"
    },
    "author": {
        "name": "Enterwell",
        "email": "services@enterwell.net",
        "url": "https://enterwell.net"
    },
    "engines": {
        "node": ">=22"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "packageManager": "pnpm@11.4.0+sha512.f0febc7e37552ab485494a914241b338e0b3580b93d54ce31f00933015880863129038a1b4ae4e414a0ee63ac35bf21197e990172c4a68256450b5636310968f",
    "scripts": {
